{
  "name": "job-board-website-with-resume-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
      "dev":         "concurrently \"npm run server\" \"npm run client\"",
      "dev:observe": "concurrently \"npm run server\" \"npm run client\" \"npm run ai\" \"npm run prometheus\" \"npm run grafana\"",
      "k6":          "concurrently \"npm run server\" \"npm run ai\" \"npm run prometheus\" \"npm run grafana\"",
      "server":      "cd backend && npm run dev",
      "client":      "cd frontend && npm run dev",
      "ai":          "cd ai-service && venv\\Scripts\\activate && python -m uvicorn app:app --reload",
      "test":        "cd backend && npm test",
      "prometheus":  "start-prometheus.bat",
      "grafana":     "cd /d \"%USERPROFILE%\\OneDrive\\Documents\\grafana-enterprise_13.0.1+security-01_25720641773_windows_amd64\\grafana-13.0.1+security-01\" && bin\\grafana.exe server --config=conf\\defaults.ini --homepath=."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env":    "^10.1.0"
  }
}